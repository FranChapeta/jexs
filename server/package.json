{
  "name": "@jexs/server",
  "version": "1.1.0",
  "license": "MIT",
  "description": "Node.js server runtime for Jexs — HTTP, routing, SQLite/MySQL/PostgreSQL, sessions, OAuth, email, web-push, WebSocket",
  "keywords": [
    "jexs",
    "json",
    "server",
    "http",
    "routing",
    "database",
    "sqlite",
    "mysql",
    "postgres",
    "session",
    "oauth",
    "declarative"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FranChapeta/jexs.git",
    "directory": "server"
  },
  "homepage": "https://github.com/FranChapeta/jexs#readme",
  "bugs": "https://github.com/FranChapeta/jexs/issues",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "jexs": {
    "nodes": "dist/index.js",
    "env": "node"
  },
  "bin": {
    "jexs": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "!dist/schema.json",
    "!dist/**/*.map"
  ],
  "peerDependencies": {
    "@jexs/core": "^1.3.0",
    "@jexs/physics": "^0.6.0",
    "better-sqlite3": ">=12.10.1",
    "mysql2": ">=3.0.0",
    "pg": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "@jexs/physics": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bcrypt": "^6.0.0",
    "esbuild": "^0.28.1",
    "ioredis": "^6.0.0",
    "knex": "^3.1.0",
    "memjs": "^1.3.0",
    "nodemailer": "^10.0.0",
    "web-push": "^3.6.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/web-push": "^3.6.0",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^13.0.0",
    "mysql2": "^3.6.0",
    "pg": "^8.23.0"
  }
}
