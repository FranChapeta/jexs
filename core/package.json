{
  "name": "@jexs/core",
  "version": "1.1.0",
  "license": "MIT",
  "description": "JSON expression resolver engine and pure-logic nodes (var, if, foreach, math, strings, arrays, dates) for Jexs",
  "keywords": [
    "jexs",
    "json",
    "expression",
    "resolver",
    "declarative",
    "interpreter",
    "logic",
    "template"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FranChapeta/jexs.git",
    "directory": "core"
  },
  "homepage": "https://github.com/FranChapeta/jexs#readme",
  "bugs": "https://github.com/FranChapeta/jexs/issues",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "jexs": { "nodes": "dist/index.js", "env": "both" },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/schema.json",
    "!dist/**/*.map"
  ]
}
