{
  "private": true,
  "workspaces": [
    "core",
    "physics",
    "client",
    "gl",
    "server",
    "mcp",
    "create"
  ],
  "devDependencies": {
    "@jexs/client": "*",
    "@jexs/core": "*",
    "@jexs/gl": "*",
    "@jexs/physics": "*",
    "@jexs/server": "*",
    "esbuild": "^0.28.1",
    "prettier": "^3.8.1",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0"
  },
  "scripts": {
    "build": "tsc -b core physics client gl server create --force && npm run build:schema",
    "build:clean": "tsc -b core physics client gl server create --clean",
    "build:schema": "jexs schema && tsx scripts/verify-schema.ts",
    "build:browser": "esbuild client=client/src/index.ts sw=client/src/sw.ts physicsWorker=client/src/physicsWorker.ts resolverWorker=client/src/resolverWorker.ts --bundle --format=esm --splitting --outdir=client/dist/browser --entry-names=[name] --chunk-names=chunks/[hash] --minify --sourcemap --target=es2022",
    "test": "node --import tsx --test core/test/*.test.ts"
  }
}
