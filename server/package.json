{
  "name": "@jexs/server",
  "version": "0.8.5",
  "license": "MIT",
  "description": "Node.js server runtime for Jexs — HTTP, routing, SQLite/MySQL, sessions, OAuth, email, web-push, WebSocket",
  "keywords": [
    "jexs",
    "json",
    "server",
    "http",
    "routing",
    "database",
    "sqlite",
    "mysql",
    "session",
    "oauth",
    "declarative"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FranChapeta/jexs.git",
    "directory": "server"
  },
  "homepage": "https://github.com/FranChapeta/jexs#readme",
  "bugs": "https://github.com/FranChapeta/jexs/issues",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "jexs": { "nodes": "dist/index.js", "env": "node" },
  "bin": {
    "jexs": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "peerDependencies": {
    "@jexs/core": "^1.0.0",
    "@jexs/physics": "^0.5.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^11.0.0",
    "esbuild": "0.28.1",
    "ioredis": "^5.3.0",
    "knex": "^3.1.0",
    "memjs": "^1.3.0",
    "mysql2": "^3.6.0",
    "nodemailer": "^9.0.3",
    "uuid": "^14.0.1",
    "web-push": "^3.6.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^7.0.10",
    "@types/uuid": "^9.0.0",
    "@types/web-push": "^3.6.0",
    "@types/ws": "^8.18.1"
  }
}
