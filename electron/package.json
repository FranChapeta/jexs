{
  "name": "@jexs/electron",
  "version": "0.6.0",
  "license": "MIT",
  "description": "Electron runtime for Jexs — window/dialog/app nodes plus a JSON-driven main-process runner (jexs-electron)",
  "keywords": [
    "jexs",
    "electron",
    "desktop",
    "ipc",
    "declarative"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FranChapeta/jexs.git",
    "directory": "electron"
  },
  "homepage": "https://github.com/FranChapeta/jexs#readme",
  "bugs": "https://github.com/FranChapeta/jexs/issues",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "jexs": {
    "nodes": "dist/index.js",
    "env": "node"
  },
  "bin": {
    "jexs-electron": "dist/runner.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "preload.cjs",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "peerDependencies": {
    "@jexs/client": "^0.9.0",
    "@jexs/core": "^1.1.0",
    "@jexs/server": "^0.9.0",
    "electron": ">=28"
  },
  "devDependencies": {
    "electron": "^43.3.0"
  }
}
