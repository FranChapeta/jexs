[
  { "as": "pkg", "file": "../package.json", "data": true },
  { "as": "schema", "file": "/.jexs/schema.json", "data": true },
  { "as": "combined", "file": "/.jexs/combined.schema.json", "data": true },
  { "as": "byNode", "coalesce": [{ "var": "$schema.byNode" }, {}] },
  { "as": "byKey", "coalesce": [{ "var": "$schema.byKey" }, {}] },
  { "as": "extraDefs", "coalesce": [{ "var": "$schema.extraDefs" }, {}] },
  { "as": "keyPackage", "coalesce": [{ "var": "$schema.keyPackage" }, {}] },
  { "as": "nodePackage", "coalesce": [{ "var": "$schema.nodePackage" }, {}] },
  { "as": "keyNode", "coalesce": [{ "var": "$schema.keyNode" }, {}] },
  { "as": "siblingDocs", "coalesce": [{ "var": "$schema.siblingDocs" }, {}] },
  { "as": "opNames", "keys": { "var": "$byKey" } },
  { "as": "pkgNames", "coalesce": [{ "var": "$schema.packages" }, []] },
  { "as": "globalDocs", "fromEntries": [["keys", { "omit": [{ "coalesce": [{ "var": "$combined.$defs.exprFlat.properties" }, {}] }, { "var": "$opNames" }] }]] },
  { "as": "globalNames", "keys": { "var": "$globalDocs.keys" } },
  { "as": "toolDefs", "file": "tools.json", "data": true },
  { "as": "walk", "file": "walk.json", "data": true },
  { "as": "walkLint", "file": "walk-lint.json", "data": true },
  { "as": "walkUnknown", "file": "walk-unknown.json", "data": true },
  { "as": "suggest", "file": "suggest.json", "data": true },
  {
    "as": "setupError",
    "if": { "or": [{ "empty": { "var": "$opNames" } }, { "empty": { "var": "$globalNames" } }] },
    "then": "No usable .jexs/schema.json or .jexs/combined.schema.json under the resolver root. Run `jexs schema` in the project root, then restart this server.",
    "else": {
      "if": { "or": [{ "empty": { "var": "$siblingDocs" } }, { "empty": { "var": "$keyNode" } }] },
      "then": "Your .jexs/schema.json was generated by an older @jexs/server and is missing `siblingDocs`/`keyNode`, so sibling keys and owning classes are unavailable. Upgrade @jexs/server and rerun `jexs schema`.",
      "else": ""
    }
  },
  { "as": "banner", "if": { "notEmpty": { "var": "$setupError" } }, "then": { "concat": [{ "var": "$setupError" }, "\n\n"] }, "else": "" },
  { "if": { "notEmpty": { "var": "$setupError" } }, "then": { "log": { "concat": ["[jexs-dev] ", { "var": "$setupError" }] } } },
  { "as": "protocolVersions", "merge": [["2024-11-05", "2025-03-26", "2025-06-18"]] },
  {
    "as": "instructions",
    "join": [
      [
        "Jexs is a JSON expression language: every object key is dispatched to a typed Node class, and its sibling keys are that node's options. A JSON array is a step sequence; the last step's value is the result.",
        "Reads come from context via `{ \"var\": \"$name\" }`; writes go through the `as` sibling or `setVars`. There is no get/set node.",
        "Use these tools instead of guessing at key names: `search_ops` to find an operation, `describe_op` for its siblings and return type, `describe_def` for a shared `#/$defs/` shape, `inspect_file` and `validate_file` to check a template you wrote, and `resolve_expression` to actually run one."
      ],
      "\n\n"
    ]
  },
  {
    "stdio-listen": true,
    "on-message": [
      { "as": "id", "var": "$message.id" },
      {
        "switch": { "var": "$message.method" },
        "cases": {
          "initialize": {
            "stdio-write": {
              "jsonrpc": "2.0",
              "id": { "var": "$id" },
              "result": {
                "protocolVersion": { "if": { "in": [{ "var": "$message.params.protocolVersion" }, { "var": "$protocolVersions" }] }, "then": { "var": "$message.params.protocolVersion" }, "else": "2025-06-18" },
                "capabilities": { "tools": {} },
                "serverInfo": { "name": "jexs-dev", "version": { "coalesce": [{ "var": "$pkg.version" }, "0.0.0"] } },
                "instructions": { "var": "$instructions" }
              }
            }
          },
          "notifications/initialized": [],
          "notifications/cancelled": [],
          "ping": { "stdio-write": { "jsonrpc": "2.0", "id": { "var": "$id" }, "result": {} } },
          "tools/list": { "stdio-write": { "jsonrpc": "2.0", "id": { "var": "$id" }, "result": { "tools": { "var": "$toolDefs" } } } },
          "tools/call": [
            { "as": "tool", "var": "$message.params.name" },
            { "as": "args", "var": "$message.params.arguments" },
            {
              "as": "result",
              "catch": [{ "content": [{ "type": "text", "text": { "concat": ["Error: ", { "coalesce": [{ "var": "$error.message" }, { "stringify": { "var": "$error" } }] }] } }], "isError": true }],
              "switch": { "var": "$tool" },
              "cases": {
                "resolve_expression": [
                  {
                    "as": "out",
                    "exec": {
                      "if": { "empty": { "var": "$args.vars" } },
                      "then": { "var": "$args.expression" },
                      "else": { "merge": [[{ "fromEntries": [["setVars", { "var": "$args.vars" }]] }], { "if": { "isType": [{ "var": "$args.expression" }, "array"] }, "then": { "var": "$args.expression" }, "else": [{ "var": "$args.expression" }] }] }
                    },
                    "catch": [{ "return": { "content": [{ "type": "text", "text": { "concat": ["Error: ", { "coalesce": [{ "var": "$error.message" }, { "stringify": { "var": "$error" } }] }] } }], "isError": true } }]
                  },
                  { "content": [{ "type": "text", "text": { "stringify": [{ "var": "$out" }, 2] } }] }
                ],
                "list_nodes": [
                  { "as": "wanted", "var": "$args.package" },
                  { "as": "classNames", "filter": [{ "keys": { "var": "$byNode" } }, { "or": [{ "empty": { "var": "$wanted" } }, { "eq": [{ "var": { "concat": ["$nodePackage.", { "var": "$item" }] } }, { "var": "$wanted" }] }] }] },
                  {
                    "as": "classLines",
                    "map": { "var": "$classNames" },
                    "item": "cls",
                    "do": {
                      "concat": [
                        { "var": "$cls" },
                        " (",
                        { "coalesce": [{ "var": { "concat": ["$nodePackage.", { "var": "$cls" }] } }, "?"] },
                        "): ",
                        {
                          "join": [
                            {
                              "map": { "var": { "concat": ["$byNode.", { "var": "$cls" }] } },
                              "item": "op",
                              "do": {
                                "concat": [
                                  { "var": "$op" },
                                  {
                                    "if": { "notEmpty": { "var": { "concat": ["$byKey.", { "var": "$op" }, ".variantDocs"] } } },
                                    "then": { "concat": [" (ops: ", { "join": [{ "map": { "var": { "concat": ["$byKey.", { "var": "$op" }, ".variantDocs"] } }, "item": "v", "do": { "var": "$v.value" } }, ", "] }, ")"] },
                                    "else": ""
                                  }
                                ]
                              }
                            },
                            ", "
                          ]
                        }
                      ]
                    }
                  },
                  {
                    "content": [
                      {
                        "type": "text",
                        "text": {
                          "concat": [
                            { "var": "$banner" },
                            "Packages: ",
                            { "join": [{ "var": "$pkgNames" }, ", "] },
                            "\n",
                            { "if": { "notEmpty": { "var": "$wanted" } }, "then": { "concat": ["Filtered to: ", { "var": "$wanted" }, "\n"] }, "else": "" },
                            "\n",
                            { "if": { "empty": { "var": "$classLines" } }, "then": { "concat": ["No node classes match \"", { "var": "$wanted" }, "\"."] }, "else": { "join": [{ "var": "$classLines" }, "\n"] } },
                            "\n\nGlobal step keys (handled by the resolver, usable on any step): ",
                            { "join": [{ "var": "$globalNames" }, ", "] }
                          ]
                        }
                      }
                    ]
                  }
                ],
                "search_ops": [
                  { "as": "q", "lower": { "coalesce": [{ "var": "$args.query" }, ""] } },
                  { "as": "qSorted", "join": [{ "sort": { "split": [{ "var": "$q" }, ""] } }, ""] },
                  { "as": "wanted", "var": "$args.package" },
                  {
                    "as": "hits",
                    "map": {
                      "filter": [
                        { "var": "$opNames" },
                        {
                          "and": [
                            { "or": [{ "empty": { "var": "$wanted" } }, { "eq": [{ "var": { "concat": ["$keyPackage.", { "var": "$item" }] } }, { "var": "$wanted" }] }] },
                            {
                              "or": [
                                { "contains": [{ "lower": { "var": "$item" } }, { "var": "$q" }] },
                                {
                                  "contains": [
                                    { "lower": { "coalesce": [{ "var": { "concat": ["$byKey.", { "var": "$item" }, ".properties.", { "var": "$item" }, ".markdownDescription"] } }, { "var": { "concat": ["$byKey.", { "var": "$item" }, ".properties.", { "var": "$item" }, ".description"] } }, ""] } },
                                    { "var": "$q" }
                                  ]
                                },
                                { "eq": [{ "join": [{ "sort": { "split": [{ "lower": { "var": "$item" } }, ""] } }, ""] }, { "var": "$qSorted" }] }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    "item": "op",
                    "do": {
                      "name": { "var": "$op" },
                      "rank": { "if": { "eq": [{ "lower": { "var": "$op" } }, { "var": "$q" }] }, "then": 0, "else": { "if": { "startsWith": [{ "lower": { "var": "$op" } }, { "var": "$q" }] }, "then": 1, "else": { "if": { "contains": [{ "lower": { "var": "$op" } }, { "var": "$q" }] }, "then": 2, "else": 3 } } },
                      "line": {
                        "concat": [
                          { "var": "$op" },
                          "  (",
                          { "coalesce": [{ "var": { "concat": ["$keyPackage.", { "var": "$op" }] } }, "?"] },
                          { "if": { "notEmpty": { "var": { "concat": ["$keyNode.", { "var": "$op" }] } } }, "then": { "concat": [" / ", { "var": { "concat": ["$keyNode.", { "var": "$op" }] } }] }, "else": "" },
                          ")",
                          { "if": { "notEmpty": { "var": { "concat": ["$byKey.", { "var": "$op" }, ".output"] } } }, "then": { "concat": [" -> ", { "var": { "concat": ["$byKey.", { "var": "$op" }, ".output"] } }] }, "else": "" },
                          "\n    ",
                          { "first": { "split": [{ "coalesce": [{ "var": { "concat": ["$byKey.", { "var": "$op" }, ".properties.", { "var": "$op" }, ".markdownDescription"] } }, { "var": { "concat": ["$byKey.", { "var": "$op" }, ".properties.", { "var": "$op" }, ".description"] } }, "(no description)"] }, "\n"] } }
                        ]
                      }
                    }
                  },
                  { "as": "ranked", "sortBy": [{ "var": "$hits" }, "rank"] },
                  { "as": "shown", "slice": [{ "var": "$ranked" }, 0, 25] },
                  {
                    "content": [
                      {
                        "type": "text",
                        "text": {
                          "concat": [
                            { "var": "$banner" },
                            {
                              "if": { "empty": { "var": "$hits" } },
                              "then": { "concat": ["No operation matches \"", { "var": "$args.query" }, "\". Try a shorter fragment, or run list_nodes."] },
                              "else": {
                                "concat": [
                                  { "count": { "var": "$hits" } },
                                  " match(es) for \"",
                                  { "var": "$args.query" },
                                  "\"",
                                  { "if": { "gt": [{ "count": { "var": "$hits" } }, 25] }, "then": ", showing the first 25", "else": "" },
                                  ":\n\n",
                                  { "join": [{ "pluck": [{ "var": "$shown" }, "line"] }, "\n"] },
                                  "\n\nRun describe_op on any of these for its siblings, return type and examples."
                                ]
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
                ],
                "describe_op": [
                  { "as": "op", "var": "$args.op" },
                  { "as": "entry", "var": { "concat": ["$byKey.", { "var": "$op" }] } },
                  {
                    "if": { "notEmpty": { "var": "$entry" } },
                    "then": [
                      { "as": "primary", "var": { "concat": ["$byKey.", { "var": "$op" }, ".properties.", { "var": "$op" }] } },
                      { "as": "cls", "coalesce": [{ "var": { "concat": ["$keyNode.", { "var": "$op" }] } }, "?"] },
                      { "as": "pkgName", "coalesce": [{ "var": { "concat": ["$keyPackage.", { "var": "$op" }] } }, "?"] },
                      { "as": "heading", "concat": [{ "var": "$cls" }, ".", { "var": "$op" }, "  (", { "var": "$pkgName" }, ")"] },
                      { "as": "desc", "coalesce": [{ "var": "$primary.markdownDescription" }, { "var": "$primary.description" }, ""] },
                      {
                        "as": "returns",
                        "if": { "notEmpty": { "var": "$entry.outputDescription" } },
                        "then": { "concat": ["Returns", { "if": { "notEmpty": { "var": "$entry.output" } }, "then": { "concat": [" (", { "var": "$entry.output" }, ")"] }, "else": "" }, ": ", { "var": "$entry.outputDescription" }] },
                        "else": { "if": { "notEmpty": { "var": "$entry.output" } }, "then": { "concat": ["Returns: ", { "var": "$entry.output" }] }, "else": "" }
                      },
                      { "as": "sibs", "coalesce": [{ "var": { "concat": ["$siblingDocs.", { "var": "$op" }] } }, []] },
                      {
                        "as": "sibBlock",
                        "if": { "notEmpty": { "var": "$sibs" } },
                        "then": {
                          "concat": [
                            "Siblings:\n",
                            {
                              "join": [
                                {
                                  "map": { "var": "$sibs" },
                                  "item": "s",
                                  "do": {
                                    "concat": [
                                      "  - ",
                                      { "var": "$s.name" },
                                      { "if": { "var": "$s.required" }, "then": " (required)", "else": "" },
                                      { "if": { "notEmpty": { "var": "$s.output" } }, "then": { "concat": [" -> ", { "var": "$s.output" }] }, "else": "" },
                                      {
                                        "if": { "notEmpty": { "var": "$s.when" } },
                                        "then": {
                                          "concat": [
                                            " [only with ",
                                            {
                                              "join": [
                                                {
                                                  "map": { "var": "$s.when" },
                                                  "item": "t",
                                                  "do": { "if": { "includes": [{ "keys": { "var": "$t" } }, "value"] }, "then": { "concat": [{ "var": "$t.key" }, ": ", { "stringify": { "var": "$t.value" } }] }, "else": { "var": "$t.key" } }
                                                },
                                                " + "
                                              ]
                                            },
                                            "]"
                                          ]
                                        },
                                        "else": ""
                                      },
                                      { "if": { "notEmpty": { "var": "$s.description" } }, "then": { "concat": [": ", { "var": "$s.description" }] }, "else": "" },
                                      { "if": { "notEmpty": { "var": "$s.outputDescription" } }, "then": { "concat": [" Returns: ", { "var": "$s.outputDescription" }] }, "else": "" },
                                      {
                                        "if": { "notEmpty": { "var": "$s.values" } },
                                        "then": {
                                          "concat": [
                                            "\n",
                                            {
                                              "join": [
                                                {
                                                  "map": { "var": "$s.values" },
                                                  "item": "v",
                                                  "do": {
                                                    "concat": [
                                                      "      - `",
                                                      { "stringify": { "var": "$v.value" } },
                                                      "`",
                                                      { "if": { "notEmpty": { "var": "$v.output" } }, "then": { "concat": [" -> ", { "var": "$v.output" }] }, "else": "" },
                                                      { "if": { "notEmpty": { "var": "$v.description" } }, "then": { "concat": [": ", { "var": "$v.description" }] }, "else": "" }
                                                    ]
                                                  }
                                                },
                                                "\n"
                                              ]
                                            }
                                          ]
                                        },
                                        "else": ""
                                      }
                                    ]
                                  }
                                },
                                "\n"
                              ]
                            }
                          ]
                        },
                        "else": ""
                      },
                      {
                        "as": "opsBlock",
                        "if": { "notEmpty": { "var": "$entry.variantDocs" } },
                        "then": {
                          "concat": [
                            "Operations (value of this key):\n",
                            {
                              "join": [
                                {
                                  "map": { "var": "$entry.variantDocs" },
                                  "item": "v",
                                  "do": {
                                    "concat": [
                                      "  - `",
                                      { "var": "$v.value" },
                                      "`",
                                      { "if": { "notEmpty": { "var": "$v.output" } }, "then": { "concat": [" -> ", { "var": "$v.output" }] }, "else": "" },
                                      { "if": { "notEmpty": { "var": "$v.description" } }, "then": { "concat": [": ", { "var": "$v.description" }] }, "else": "" }
                                    ]
                                  }
                                },
                                "\n"
                              ]
                            }
                          ]
                        },
                        "else": ""
                      },
                      { "as": "exBlock", "if": { "notEmpty": { "var": "$primary.examples" } }, "then": { "concat": ["Examples:\n", { "join": [{ "map": { "var": "$primary.examples" }, "item": "ex", "do": { "concat": ["  ", { "var": "$ex" }] } }, "\n"] }] }, "else": "" },
                      { "content": [{ "type": "text", "text": { "concat": [{ "var": "$banner" }, { "join": [{ "filter": [[{ "var": "$heading" }, { "var": "$desc" }, { "var": "$returns" }, { "var": "$sibBlock" }, { "var": "$opsBlock" }, { "var": "$exBlock" }], { "notEmpty": { "var": "$item" } }] }, "\n\n"] }] } }] }
                    ],
                    "else": [
                      { "as": "g", "var": { "concat": ["$globalDocs.keys.", { "var": "$op" }] } },
                      {
                        "if": { "and": [{ "notEmpty": { "var": "$g" } }, { "includes": [{ "var": "$globalNames" }, { "var": "$op" }] }] },
                        "then": {
                          "content": [
                            {
                              "type": "text",
                              "text": {
                                "concat": [
                                  { "var": "$banner" },
                                  "(global step key) ",
                                  { "var": "$op" },
                                  "\n\n",
                                  { "coalesce": [{ "var": "$g.markdownDescription" }, { "var": "$g.description" }, ""] },
                                  { "if": { "notEmpty": { "var": "$g.examples" } }, "then": { "concat": ["\n\nExamples:\n", { "join": [{ "map": { "var": "$g.examples" }, "item": "ex", "do": { "concat": ["  ", { "var": "$ex" }] } }, "\n"] }] }, "else": "" }
                                ]
                              }
                            }
                          ]
                        },
                        "else": [
                          { "as": "near", "exec": { "var": "$suggest" }, "params": { "needle": { "var": "$op" }, "haystack": { "var": "$opNames" } } },
                          {
                            "content": [
                              {
                                "type": "text",
                                "text": {
                                  "concat": [{ "var": "$banner" }, "Unknown op: ", { "var": "$op" }, "\n", { "if": { "notEmpty": { "var": "$near" } }, "then": { "concat": ["Did you mean: ", { "join": [{ "var": "$near" }, ", "] }, "?"] }, "else": "Run search_ops to find an operation, or list_nodes to see them all." }]
                                }
                              }
                            ],
                            "isError": true
                          }
                        ]
                      }
                    ]
                  }
                ],
                "describe_def": [
                  { "as": "name", "replace": [{ "var": "$args.name" }, "#/$defs/", ""] },
                  { "as": "def", "var": { "concat": ["$extraDefs.", { "var": "$name" }] } },
                  {
                    "if": { "notEmpty": { "var": "$def" } },
                    "then": { "content": [{ "type": "text", "text": { "concat": [{ "var": "$banner" }, { "var": "$name" }, "\n\n", { "stringify": [{ "var": "$def" }, 2] }] } }] },
                    "else": [
                      { "as": "defNames", "keys": { "var": "$extraDefs" } },
                      { "as": "near", "exec": { "var": "$suggest" }, "params": { "needle": { "var": "$name" }, "haystack": { "var": "$defNames" } } },
                      {
                        "content": [
                          {
                            "type": "text",
                            "text": {
                              "concat": [
                                { "var": "$banner" },
                                "Unknown $defs: ",
                                { "var": "$name" },
                                "\n",
                                { "if": { "notEmpty": { "var": "$near" } }, "then": { "concat": ["Did you mean: ", { "join": [{ "var": "$near" }, ", "] }, "?"] }, "else": { "concat": ["Available: ", { "join": [{ "sort": { "var": "$defNames" } }, ", "] }] } }
                              ]
                            }
                          }
                        ],
                        "isError": true
                      }
                    ]
                  }
                ],
                "inspect_file": [
                  { "as": "box", "fromEntries": [["node", { "file": { "concat": ["/", { "var": "$args.filePath" }] }, "data": true }]] },
                  {
                    "if": { "empty": { "var": "$box.node" } },
                    "then": { "content": [{ "type": "text", "text": { "concat": [{ "var": "$banner" }, "Error: could not read or parse ", { "var": "$args.filePath" }, " (missing, empty, or not JSON)."] } }], "isError": true },
                    "else": [
                      { "as": "allKeys", "unique": { "flatten": { "exec": { "var": "$walk" }, "params": { "node": { "var": "$box.node" } } } } },
                      { "as": "usedKeys", "sort": { "filter": [{ "var": "$allKeys" }, { "includes": [{ "var": "$opNames" }, { "var": "$item" }] }] } },
                      { "as": "unknownKeys", "exec": { "var": "$walkUnknown" }, "params": { "node": { "var": "$box.node" }, "path": "" } },
                      { "as": "warnings", "exec": { "var": "$walkLint" }, "params": { "node": { "var": "$box.node" }, "path": "" } },
                      { "as": "lintText", "if": { "notEmpty": { "var": "$warnings" } }, "then": { "join": [{ "map": { "var": "$warnings" }, "item": "w", "do": { "concat": ["  - ", { "var": "$w" }] } }, "\n"] }, "else": "  none" },
                      { "as": "unknownText", "if": { "notEmpty": { "var": "$unknownKeys" } }, "then": { "join": [{ "map": { "sort": { "unique": { "var": "$unknownKeys" } } }, "item": "k", "do": { "concat": ["  - ", { "var": "$k" }] } }, "\n"] }, "else": "  none" },
                      {
                        "content": [
                          {
                            "type": "text",
                            "text": {
                              "concat": [
                                { "var": "$banner" },
                                "File: ",
                                { "var": "$args.filePath" },
                                "\n",
                                "Packages: ",
                                { "join": [{ "var": "$pkgNames" }, ", "] },
                                "\n\n",
                                "Node keys used:\n  ",
                                { "join": [{ "var": "$usedKeys" }, ", "] },
                                "\n\n",
                                "Possible typos (a key that is not an op, a global key, or a sibling of its step's op, but is one character-shuffle away from one):\n",
                                { "var": "$unknownText" },
                                "\n\n",
                                "Lint (advisory):\n",
                                { "var": "$lintText" }
                              ]
                            }
                          }
                        ]
                      }
                    ]
                  }
                ],
                "validate_file": [
                  { "as": "box", "fromEntries": [["node", { "file": { "concat": ["/", { "var": "$args.filePath" }] }, "data": true }]] },
                  {
                    "if": { "empty": { "var": "$box.node" } },
                    "then": { "content": [{ "type": "text", "text": { "concat": [{ "var": "$banner" }, "Error: could not read or parse ", { "var": "$args.filePath" }, " (missing, empty, or not JSON)."] } }], "isError": true },
                    "else": [
                      { "as": "report", "schema": "validate", "document": { "var": "$combined" }, "data": { "var": "$box.node" } },
                      {
                        "if": { "var": "$report.valid" },
                        "then": { "content": [{ "type": "text", "text": { "concat": [{ "var": "$banner" }, { "var": "$args.filePath" }, " validates against the project schema."] } }] },
                        "else": [
                          { "as": "real", "filter": [{ "var": "$report.errors" }, { "not": { "in": [{ "var": "$item.keyword" }, ["anyOf", "oneOf", "if", "not"]] } }] },
                          { "as": "deep", "filter": [{ "var": "$real" }, { "notEmpty": { "var": "$item.path" } }] },
                          { "as": "kept", "if": { "notEmpty": { "var": "$deep" } }, "then": { "var": "$deep" }, "else": { "var": "$real" } },
                          { "as": "lines", "unique": { "map": { "var": "$kept" }, "item": "e", "do": { "concat": ["  ", { "if": { "empty": { "var": "$e.path" } }, "then": "(root)", "else": { "var": "$e.path" } }, ": ", { "var": "$e.message" }] } } },
                          {
                            "content": [
                              {
                                "type": "text",
                                "text": {
                                  "concat": [
                                    { "var": "$banner" },
                                    { "var": "$args.filePath" },
                                    " does not validate against the project schema.\n\n",
                                    { "join": [{ "slice": [{ "var": "$lines" }, 0, 20] }, "\n"] },
                                    { "if": { "gt": [{ "count": { "var": "$lines" } }, 20] }, "then": { "concat": ["\n  ... and ", { "count": { "var": "$lines" } }, " distinct errors in total."] }, "else": "" },
                                    "\n\nThese are the paths where a schema branch rejected the document; the union bookkeeping (anyOf/oneOf) is filtered out. A key the schema does not know is usually a typo or a package that is not installed."
                                  ]
                                }
                              }
                            ],
                            "isError": true
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              "default": { "content": [{ "type": "text", "text": { "concat": ["Unknown tool: ", { "var": "$tool" }, ". Available: ", { "join": [{ "pluck": [{ "var": "$toolDefs" }, "name"] }, ", "] }] } }], "isError": true }
            },
            { "stdio-write": { "jsonrpc": "2.0", "id": { "var": "$id" }, "result": { "var": "$result" } } }
          ]
        },
        "default": [
          {
            "if": { "notEmpty": { "var": "$id" } },
            "then": {
              "stdio-write": {
                "fromEntries": [
                  ["jsonrpc", "2.0"],
                  ["id", { "var": "$id" }],
                  ["error", { "code": -32601, "message": { "concat": ["Method not found: ", { "var": "$message.method" }] } }]
                ]
              }
            },
            "else": null
          }
        ],
        "catch": [
          {
            "if": { "notEmpty": { "var": "$id" } },
            "then": {
              "stdio-write": {
                "fromEntries": [
                  ["jsonrpc", "2.0"],
                  ["id", { "var": "$id" }],
                  ["error", { "code": -32603, "message": { "concat": ["Internal error: ", { "coalesce": [{ "var": "$error.message" }, { "stringify": { "var": "$error" } }] }] } }]
                ]
              }
            },
            "else": null
          }
        ]
      }
    ]
  }
]
