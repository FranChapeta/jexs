{
  "name": "@jexs/client",
  "version": "2.0.0",
  "license": "MIT",
  "description": "Browser runtime for Jexs — DOM, fetch, audio, WebSocket, push, and WebRTC nodes",
  "keywords": [
    "jexs",
    "json",
    "browser",
    "client",
    "dom",
    "declarative",
    "ui",
    "websocket",
    "fetch"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FranChapeta/jexs.git",
    "directory": "client"
  },
  "homepage": "https://github.com/FranChapeta/jexs#readme",
  "bugs": "https://github.com/FranChapeta/jexs/issues",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "jexs": { "env": "browser" },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./sw": "./dist/sw.js",
    "./resolver-worker": "./dist/resolverWorker.js",
    "./physics-worker": "./dist/physicsWorker.js"
  },
  "files": [
    "dist",
    "!dist/schema.json",
    "!dist/**/*.map"
  ],
  "scripts": {
    "prepublishOnly": "tsc -b"
  },
  "peerDependencies": {
    "@jexs/core": "^2.0.0",
    "@jexs/physics": "^0.7.0",
    "@jexs/gl": "^0.7.0"
  },
  "peerDependenciesMeta": {
    "@jexs/physics": {
      "optional": true
    },
    "@jexs/gl": {
      "optional": true
    }
  }
}
